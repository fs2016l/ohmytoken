{
  "name": "ohmytoken",
  "version": "1.2.2",
  "description": "本地 AI Agent Token 用量观测桌面应用",
  "main": "./out/main/index.js",
  "author": "fs2016l",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "font:material": "node scripts/generate-material-symbols.mjs",
    "font:ui": "node scripts/generate-ui-fonts.mjs",
    "start": "electron-vite preview",
    "prebuild": "node scripts/validate-production-config.mjs",
    "build": "electron-vite build",
    "release:validate": "node scripts/validate-release-version.mjs",
    "prebuild:win": "npm run release:validate",
    "build:win": "npm run build && electron-builder --win --x64",
    "prebuild:mac": "npm run release:validate",
    "build:mac": "npm run build && electron-builder --mac",
    "build:unpack": "npm run build && electron-builder --dir",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^4.0.0",
    "better-sqlite3": "^12.11.1",
    "dompurify": "^3.4.12",
    "electron-updater": "^6.8.9",
    "marked": "^18.0.5",
    "proper-lockfile": "^4.1.2",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.0",
    "@types/proper-lockfile": "^4.1.4",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vuepic/vue-datepicker": "^14.0.0",
    "axios": "^1.16.1",
    "date-fns": "^4.4.0",
    "echarts": "^6.1.0",
    "electron": "^42.5.2",
    "electron-builder": "^26.15.6",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "prettier": "^3.8.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.0",
    "vite": "^6.0.7",
    "vue": "^3.5.13",
    "vue-echarts": "^8.0.1",
    "vue-tsc": "^2.1.10"
  }
}
